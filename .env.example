# PostgreSQL (docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=snaptle
DB_USERNAME=snaptle
DB_PASSWORD=snaptle

# JPA
JPA_DDL_AUTO=update

# Server
SERVER_PORT=8080

# JWT - generate a random 32+ byte secret for real environments
JWT_SECRET=CHANGE_ME_LOCAL_DEV_ONLY_MIN_32_BYTES_SECRET_KEY
JWT_ACCESS_EXPIRATION_MS=3600000

# Kakao OAuth2 (발급: https://developers.kakao.com)
# 비워두면 부팅용 placeholder 값이 대신 채워지며, 카카오 로그인 자체는 동작하지 않습니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 카카오 로그인 성공 후 accessToken을 전달할 프론트엔드 콜백 주소
FRONTEND_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# 영수증 OCR (Gemini, 발급: https://aistudio.google.com/apikey)
# 비워두면 OCR을 건너뛰고 수동 입력을 요구합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 환율 조회 (발급: https://www.exchangerate-api.com)
# 비워두면 자동 환율 조회를 건너뛰고 수동 환율 입력을 요구합니다.
EXCHANGE_RATE_API_KEY=

# 영수증 이미지 로컬 저장 경로 및 공개 URL 베이스
FILE_UPLOAD_DIR=./uploads/receipts
FILE_PUBLIC_BASE_URL=http://localhost:8080/uploads
