# PostgreSQL (docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=snaptle
DB_USERNAME=snaptle
DB_PASSWORD=snaptle

# JPA
JPA_DDL_AUTO=update

# Server
SERVER_PORT=8080

# JWT - generate a random 32+ byte secret for real environments
JWT_SECRET=CHANGE_ME_LOCAL_DEV_ONLY_MIN_32_BYTES_SECRET_KEY
JWT_ACCESS_EXPIRATION_MS=3600000

# Kakao OAuth2 (발급: https://developers.kakao.com)
# 비워두면 부팅용 placeholder 값이 대신 채워지며, 카카오 로그인 자체는 동작하지 않습니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 카카오 로그인 성공 후 accessToken을 전달할 프론트엔드 콜백 주소
FRONTEND_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# 영수증 OCR (Gemini)
GEMINI_API_KEY=

# 환율 조회
EXCHANGE_RATE_API_KEY=
